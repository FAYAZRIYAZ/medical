# ============================================================
# HIMS — Environment Variable Reference
# Copy to .env and fill in values before running
# ============================================================

# ----- App -----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
API_VERSION=v1

# ----- MongoDB -----
MONGODB_URI=mongodb://localhost:27017/hims
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/hims?retryWrites=true&w=majority

# ----- Redis -----
REDIS_URL=redis://localhost:6379
# For Redis Cloud: redis://:password@host:port

# ----- JWT -----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Cookies -----
COOKIE_SECRET=change-me-cookie-secret-min-32-chars

# ----- Argon2 -----
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ----- Email (Nodemailer) -----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hims.local

# ----- Twilio (SMS + WhatsApp) -----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ----- MSG91 (India SMS adapter) -----
MSG91_AUTH_KEY=
MSG91_SENDER_ID=HIMS
MSG91_TEMPLATE_ID_OTP=

# ----- Cloudinary (media storage) -----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ----- MinIO (self-hosted S3 alternative) -----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hims-uploads

# ----- Storage adapter: 'cloudinary' | 'minio' | 's3' -----
STORAGE_ADAPTER=minio

# ----- AWS S3 (if STORAGE_ADAPTER=s3) -----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ----- Razorpay (India payments primary) -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ----- Stripe (international payments) -----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# ----- LiveKit (Telemedicine) -----
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_URL=wss://your-livekit-server.com
# Self-hosted: ws://localhost:7880

# ----- Sentry -----
SENTRY_DSN=https://xxx@sentry.io/xxx

# ----- Google OAuth (social login for patients) -----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ----- TOTP (2FA) -----
TOTP_ISSUER=HIMS

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3

# ----- BullMQ / BullBoard -----
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123

# ----- Multi-tenancy -----
PLATFORM_SUPER_ADMIN_EMAIL=superadmin@hims.io
PLATFORM_SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ----- Encryption (field-level) -----
FIELD_ENCRYPTION_KEY=64-char-hex-string-for-aes-256-gcm

# ----- Feature Flags -----
FEATURE_BLOOD_BANK=false
FEATURE_AI_SUGGESTIONS=false
FEATURE_AMBULANCE=false
FEATURE_WHATSAPP_BOT=false
